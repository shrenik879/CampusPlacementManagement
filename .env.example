# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Campus Placement System
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=campus_user
DB_PASSWORD=ChangeMeToAStrongPassword123!
# DB_HOST defaults to localhost if not set
# DB_PORT defaults to 3306 if not set

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Found in your Cloudinary Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use a Gmail App Password (not your main account password)
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_app_password_16_chars

# ── Redis ─────────────────────────────────────────────────────────────────────
# Defaults to localhost:6379 if not set
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Used for password reset email links.
# Set to your frontend's public address.
# Example: http://3.14.159.26:3000  or  https://yourapp.com
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP:3000
