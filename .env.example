# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Campus Placement System (Backend)
# Copy this file to .env for local dev and fill in real values.
# In production (Render): set these as Environment Variables in the Render dashboard.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MySQL) ──────────────────────────────────────────────────────────
# Use PlanetScale, Aiven, Railway, or any managed MySQL service on Render.
DB_USERNAME=campus_user
DB_PASSWORD=ChangeMeToAStrongPassword123!
DB_HOST=localhost        # e.g. your-db.aivencloud.com or mysql.railway.internal
DB_PORT=3306

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS

# ── Cloudinary (file / resume uploads) ────────────────────────────────────────
# Found in your Cloudinary Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Gemini AI (resume parsing / recommendations) ──────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use a Gmail App Password (not your main account password)
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_app_password_16_chars

# ── Redis ─────────────────────────────────────────────────────────────────────
# Use Upstash Redis (free tier) or Render's managed Redis.
# Defaults to localhost:6379 if not set.
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Used for password reset email links.
# Set to your Vercel deployment URL in production.
# Example: https://campus-placement-management.vercel.app
FRONTEND_URL=http://localhost:5173

# ── CORS Extra Origins ────────────────────────────────────────────────────────
# Comma-separated list of additional origins to allow (beyond FRONTEND_URL).
# Leave empty unless you have staging/preview deployments.
# Example: https://staging.vercel.app,http://localhost:3000
CORS_EXTRA_ORIGINS=
