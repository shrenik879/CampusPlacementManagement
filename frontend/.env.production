# Frontend production environment for Vercel
#
# VITE_API_URL is intentionally empty — the frontend uses relative /api/* paths.
# Vercel's rewrites in vercel.json proxy /api/* to the Render backend.
# This means no CORS issues and no hardcoded backend URL in the frontend bundle.
VITE_API_URL=

# Optional: set this in Vercel dashboard as an Environment Variable instead of here.
# VITE_DEV_BACKEND_URL is only used by vite.config.js proxy during LOCAL development.
