# Frontend production environment for Vercel
#
# VITE_API_URL — intentionally empty.
# The frontend uses relative /api/* paths; vercel.json rewrites proxy them to Render.
# This means no hardcoded backend URL in the JS bundle.
VITE_API_URL=

# VITE_WS_URL — REQUIRED for real-time WebSocket notifications in production.
# Vercel CANNOT proxy WebSocket upgrades, so SockJS must connect directly to Render.
# Set this in the Vercel dashboard → Settings → Environment Variables.
# Format: https://your-actual-render-service.onrender.com  (no trailing slash)
# Example: https://campus-placement-backend.onrender.com
#
# IMPORTANT: Do NOT set this here — set it in the Vercel dashboard so it is not
# committed to the repository. This file is only for documentation purposes.
# VITE_WS_URL=https://your-render-service.onrender.com
